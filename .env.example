# Coordinador
GPU_MESH_HOST=127.0.0.1
GPU_MESH_PORT=8787
GPU_MESH_DB=./data/gpu-mesh.db
GPU_MESH_REQUEST_TIMEOUT_MS=120000
MYCELLIOS_LANDING_DIST=./landing-dist
MYCELLIOS_MOBILE_DIST=./mobile-dist
MYCELLIOS_DESKTOP_UPDATES_DIST=./updates/win32/x64
MYCELLIOS_COMPONENT_UPDATES_DIST=./runtime/component-updates
# Public Ed25519 trust roots for lightweight signed components. Dev and stable
# use different keys; private signing keys never belong on the coordinator.
# Namespaced development labs persist their own public keys below the component
# update directory and therefore need only this path plus admin authorization.
MYCELLIOS_COMPONENT_UPDATE_DEV_KEY_ID=
MYCELLIOS_COMPONENT_UPDATE_DEV_PUBLIC_KEY=
# MYCELLIOS_COMPONENT_UPDATE_DEV_PUBLIC_KEY_FILE=/run/secrets/mycellios-dev-update-public.spki
# MYCELLIOS_COMPONENT_UPDATE_DEV_KEYRING_FILE=/run/secrets/mycellios-dev-update-keyring.json
MYCELLIOS_COMPONENT_UPDATE_STABLE_KEY_ID=
MYCELLIOS_COMPONENT_UPDATE_STABLE_PUBLIC_KEY=
# MYCELLIOS_COMPONENT_UPDATE_STABLE_PUBLIC_KEY_FILE=/run/secrets/mycellios-stable-update-public.spki
# MYCELLIOS_COMPONENT_UPDATE_STABLE_KEYRING_FILE=/run/secrets/mycellios-stable-update-keyring.json
MYCELLIOS_MOBILE_EXPERTS=./runtime/mobile-experts
# Required whenever the coordinator listens outside loopback. Remote native
# workers need this bearer token and also prove possession of their device key.
MYCELLIOS_NETWORK_TOKEN=
# Optional PWA invitation. When configured, it protects both the one-time
# identity challenge and final browser registration.
MYCELLIOS_MOBILE_JOIN_TOKEN=

# Acceso OpenAI-compatible por cuenta. En producción se activa junto con
# Supabase Auth y mantiene claves, saldo y consumo en la base indicada por GPU_MESH_DB.
MYCELLIOS_API_ACCESS_ENABLED=0
MYCELLIOS_API_STARTER_TOKENS=25000
MYCELLIOS_API_REQUESTS_PER_MINUTE=30
MYCELLIOS_API_MAX_CONCURRENT=2
MYCELLIOS_API_MAX_ACTIVE_KEYS=10
MYCELLIOS_PUBLIC_API_BASE_URL=http://127.0.0.1:8787/v1

# Worker
GPU_MESH_COORDINATOR=http://127.0.0.1:8787
GPU_MESH_WORKER_CONFIG=./config/worker.example.json
# Stable Ed25519 identity for the standalone worker. Keep this file persistent
# and private; changing it requires an explicit credential rotation.
MYCELLIOS_WORKER_CREDENTIAL_PATH=./runtime/worker-admission-credential.json
# Optional infrastructure-side executor pool. Once configured by the deployment,
# users add and activate compatible models entirely from the interface.
MYCELLIOS_AUTO_DISTRIBUTE_CONFIG=
# Enable connected native executors and, optionally, a strict content-addressed
# engine authority document for physical per-stage profile challenges.
MYCELLIOS_DYNAMIC_WORKER_ACTIVATION=0
MYCELLIOS_ENGINE_ACTIVATION_AUTHORITY=
MYCELLIOS_MODEL_ADMIN_TOKEN=
# MYCELLIOS_MODEL_ADMIN_TOKEN_FILE=C:\secure\mycellios-model-admin-token.txt

# Content Hub
# The Mycellios coordinator already uses 8787; start Content Hub with PORT=8788 locally.
CONTENT_HUB_API_URL=http://127.0.0.1:8788
MYCELLIOS_PUBLICATION_WEBHOOK_SECRET=
# MYCELLIOS_PUBLICATION_WEBHOOK_SECRET_FILE=/run/secrets/mycellios-content-hub-webhook
