{
  "name": "mycellios",
  "productName": "mycellios",
  "version": "0.2.77",
  "private": true,
  "packageManager": "npm@10.9.8",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "author": "mycellios",
  "description": "mycellios: heterogeneous distributed LLM inference runtime and scheduler.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tych0s/mycellios.git"
  },
  "homepage": "https://www.mycellios.com",
  "bugs": "https://github.com/tych0s/mycellios/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && npm run verify:structure && tsc -p tsconfig.build.json && npm run mobile:build && npm run landing:build && node scripts/write-coordinator-output-receipt.mjs",
    "check": "npm run verify:structure && npm run verify:docs && npm run verify:format && npm run verify:architecture && npm run verify:component-boundaries && npm run typecheck && npm run landing:typecheck && npm run mobile:typecheck && npm test",
    "doctor": "node scripts/developer-doctor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run landing:dev",
    "dev:coordinator": "tsx src/coordinator/main.ts",
    "dev:worker": "tsx src/worker/main.ts",
    "dev:launch-agent": "tsx src/distribution/launch-agent-daemon-cli.ts",
    "dev:update:keygen": "tsx scripts/component-update-cli.ts keygen",
    "dev:update:coordinator": "tsx scripts/component-update-cli.ts coordinator",
    "dev:update:prepare": "tsx scripts/component-update-cli.ts prepare",
    "dev:update:publish": "tsx scripts/component-update-cli.ts publish",
    "dev:update:ship": "tsx scripts/component-update-cli.ts ship",
    "start:coordinator": "node dist/coordinator/main.js",
    "start:worker": "node dist/worker/main.js",
    "start:worker:headless": "node dist/worker/headless-main.js",
    "start:node": "node dist/node/main.js",
    "dev:node": "tsx src/node/main.ts",
    "start:launch-agent": "node dist/distribution/launch-agent-daemon-cli.js",
    "demo": "tsx src/demo.ts",
    "simulate": "tsx src/simulator/cli.ts",
    "simulate:wan": "tsx src/simulator/wan-cli.ts",
    "simulate:physics": "tsx src/simulator/wan-physics-cli.ts",
    "simulate:distribution": "tsx src/distribution/cli.ts",
    "simulate:architectures": "tsx src/distribution/architecture-cli.ts",
    "simulate:sensitivity": "tsx src/distribution/sensitivity.ts",
    "plan:distribution": "tsx src/distribution/runtime-plan-cli.ts",
    "compile:python-launch": "tsx src/distribution/python-launcher-cli.ts",
    "model:auto-distribute": "tsx src/distribution/auto-distribute-cli.ts",
    "preflight:two-host": "tsx src/distribution/two-host-preflight-cli.ts",
    "plan:macro-wave": "tsx src/distribution/macro-wave-cli.ts",
    "profile:model": "powershell -ExecutionPolicy Bypass -File scripts/profile-distributed-model.ps1",
    "compile:cell-fixture": "powershell -ExecutionPolicy Bypass -File scripts/compile-cell-fixture.ps1",
    "setup:distribution-runtime": "powershell -ExecutionPolicy Bypass -File scripts/setup-distribution-runtime.ps1",
    "benchmark:distributed": "powershell -ExecutionPolicy Bypass -File scripts/benchmark-distributed.ps1",
    "benchmark:distributed-api": "powershell -ExecutionPolicy Bypass -File scripts/benchmark-distributed-api.ps1",
    "benchmark:conversation": "powershell -ExecutionPolicy Bypass -File scripts/benchmark-conversation.ps1",
    "benchmark:verify-conveyor-runtime": "powershell -ExecutionPolicy Bypass -File scripts/benchmark-verify-conveyor-runtime.ps1",
    "benchmark:lab": "tsx src/benchlab/cli.ts run",
    "benchmark:lab:dashboard": "tsx src/benchlab/server.ts --open",
    "benchmark:lab:serve": "tsx src/benchlab/server.ts",
    "benchmark:lab:physical-import": "tsx src/benchlab/cli.ts import-physical",
    "serve:distributed": "powershell -ExecutionPolicy Bypass -File scripts/serve-distributed.ps1",
    "stage:distributed": "powershell -ExecutionPolicy Bypass -File scripts/run-distributed-stage.ps1",
    "cell-member:distributed": "powershell -ExecutionPolicy Bypass -File scripts/run-cell-member.ps1",
    "test:distribution-runtime": "powershell -ExecutionPolicy Bypass -File scripts/test-distribution-runtime.ps1",
    "test:physical-launcher": "powershell -ExecutionPolicy Bypass -Command \"$env:RUN_PHYSICAL_LAUNCHER_TESTS='1'; npm test -- --run tests/launch-supervisor-physical.test.ts\"",
    "test:physical-external-cell": "powershell -ExecutionPolicy Bypass -Command \"$env:RUN_PHYSICAL_EXTERNAL_CELL_TESTS='1'; npm test -- --run tests/launch-supervisor-external-cell-physical.test.ts\"",
    "test:physical-expert-parallel-cell": "powershell -ExecutionPolicy Bypass -File scripts/test-physical-expert-parallel-cell.ps1",
    "test:physical-qwen3-stage": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='python'; $env:HF_HOME='runtime/hf-cache'; $env:RUN_QWEN3_MODEL_TESTS='1'; $python = & 'scripts/resolve-distribution-python.ps1' -WorkspacePath (Get-Location).Path; & $python -m unittest -v python.tests.test_qwen3_partition; exit $LASTEXITCODE\"",
    "test:physical-recovery": "powershell -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='python'; $env:HF_HOME='runtime/hf-cache'; $env:RUN_PHYSICAL_RECOVERY_TESTS='1'; $python = & 'scripts/resolve-distribution-python.ps1' -WorkspacePath (Get-Location).Path; & $python -m unittest -v python.tests.test_recovery_physical; exit $LASTEXITCODE\"",
    "test:physical-gpu-cell": "powershell -ExecutionPolicy Bypass -File scripts/test-physical-gpu-cell.ps1",
    "reference:physical-gpu-canary": "powershell -ExecutionPolicy Bypass -File scripts/generate-physical-gpu-canary-reference.ps1",
    "campaign:physical-gpu": "tsx src/distribution/physical-gpu-campaign-cli.ts",
    "campaign:physical-gpu-conveyor-ab": "tsx src/distribution/physical-gpu-conveyor-ab-cli.ts",
    "verify:physical-gpu-gate": "tsx src/distribution/physical-gpu-gate-cli.ts",
    "verify:wan-pilot": "tsx src/distribution/wan-pilot-gate-cli.ts",
    "test": "vitest run",
    "verify:component-boundaries": "tsx scripts/verify-component-boundaries.ts",
    "verify:architecture": "tsx scripts/verify-architecture.ts",
    "verify:structure": "node scripts/verify-repository-structure.mjs",
    "verify:docs": "node scripts/verify-documentation.mjs",
    "verify:format": "node scripts/verify-text-format.mjs",
    "verify:bundle": "node scripts/verify-web-bundle-budget.mjs",
    "verify:bundle:landing": "node scripts/verify-web-bundle-budget.mjs --surface=landing",
    "verify:bundle:mobile": "node scripts/verify-web-bundle-budget.mjs --surface=mobile",
    "version:check": "node scripts/node-release-version.mjs --check",
    "version:bump": "node scripts/node-release-version.mjs --bump",
    "coordinator:release:prepare": "node scripts/prepare-coordinator-release.mjs",
    "coordinator:release:verify": "node scripts/verify-coordinator-release.mjs --root=build/coordinator-release",
    "test:watch": "vitest",
    "smoke:public": "node scripts/smoke-public-network.mjs",
    "verify:stripe-sandbox": "node scripts/verify-stripe-sandbox.mjs",
    "smoke:runtime-profile:local": "tsx scripts/smoke-runtime-performance-profile.ts",
    "smoke:model-profile:local": "tsx scripts/smoke-model-profile-local.ts",
    "dev:e2e:distributed": "tsx scripts/dev-distributed-e2e.ts",
    "diagnostics:remote": "tsx scripts/read-remote-diagnostics.ts",
    "pilot:public:qwen:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-public-qwen-pilot.ps1",
    "pilot:public:qwen:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-public-qwen-pilot.ps1",
    "node:isolation-broker": "node scripts/build-windows-job-broker.mjs",
    "node:python-source": "node scripts/prepare-packaged-python-source.mjs",
    "node:runtime:check": "node scripts/check-portable-runtime-policy.mjs",
    "node:runtime:archive-check": "npm run node:python-source && node scripts/verify-portable-runtime-archive.mjs --python-source=build/python",
    "node:runtime:setup": "node scripts/setup-portable-distribution-runtime.mjs",
    "node:runtime": "npm run node:python-source && npm run node:runtime:check && npm run node:runtime:setup && node scripts/prepare-portable-distribution-runtime.mjs",
    "node:stage": "node scripts/stage-node-installer.mjs",
    "node:stage:verify": "node scripts/verify-node-installer.mjs",
    "node:package:deb": "node scripts/build-node-deb.mjs",
    "node:package:deb:verify": "node scripts/verify-node-deb.mjs",
    "node:package:pkg": "node scripts/build-node-pkg.mjs",
    "node:package:pkg:verify": "node scripts/verify-node-pkg.mjs",
    "node:package:msi": "node scripts/build-node-msi.mjs",
    "node:package:msi:verify": "node scripts/verify-node-msi.mjs",
    "node:release:evidence": "node scripts/node-release-evidence.mjs",
    "node:release:evidence:verify": "node scripts/verify-node-release-evidence.mjs",
    "landing:dev": "vite --config vite.landing.config.ts",
    "landing:build": "vite build --config vite.landing.config.ts && tsx scripts/generate-landing-seo.ts && npm run verify:bundle:landing",
    "landing:preview": "vite preview --config vite.landing.config.ts",
    "landing:local": "npm run landing:build && vite preview --config vite.landing.config.ts",
    "landing:typecheck": "tsc -p tsconfig.landing.json --noEmit",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:typecheck": "tsc -p tsconfig.mobile.json --noEmit",
    "mobile:build": "vite build --config vite.mobile.config.ts && npm run verify:bundle:mobile",
    "mobile:serve": "npm run mobile:build && tsx src/coordinator/main.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-sigma/core": "^5.0.6",
    "@remotion/player": "^4.0.498",
    "fastify": "5.12.4",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "jose": "^6.2.3",
    "lucide-react": "^1.44.0",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.498",
    "sigma": "^3.0.3",
    "three": "0.185.1",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@webgpu/types": "^0.1.71",
    "pe-library": "1.0.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "4.1.11",
    "yauzl": "2.10.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
