# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm AS python-runtime

FROM python-runtime AS coordinator-python-runtime
COPY scripts/wheel-locks/linux-x64-cp312.txt /tmp/linux-x64-cp312.txt
RUN --mount=type=cache,id=mycellios-pip-coordinator,target=/root/.cache/pip,sharing=locked \
    python -m pip install \
      --require-hashes \
      --no-deps \
      -r /tmp/linux-x64-cp312.txt \
    && python -c "import safetensors,torch,transformers; print(torch.__version__, transformers.__version__, safetensors.__version__)"

FROM node:24-bookworm-slim AS node-runtime

FROM node-runtime AS build
ARG DOKPLOY_DEPLOY_SHA
COPY --from=python-runtime /usr/local /opt/python
ENV PATH="/opt/python/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/python/lib"
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=mycellios-npm-build,target=/root/.npm,sharing=locked \
    npm ci --no-audit --no-fund
COPY . .
RUN node scripts/prepare-coordinator-runtime-identity.mjs \
      --revision="${DOKPLOY_DEPLOY_SHA}" \
    && npm run build

# Keep the Python image as the OS base so its dynamically linked standard
# library extensions retain all Debian runtime dependencies (notably OpenSSL).
# Node's /usr/local tree merges cleanly with the sealed Python installation.
FROM coordinator-python-runtime AS runtime
COPY --from=node-runtime /usr/local /usr/local
ENV NODE_ENV=production \
    PYTHONUNBUFFERED=1
RUN node --version \
    && npm --version \
    && python -c "import ssl,safetensors,torch,transformers; print(ssl.OPENSSL_VERSION, torch.__version__, transformers.__version__, safetensors.__version__)"
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=mycellios-npm-runtime,target=/root/.npm,sharing=locked \
    npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/landing-dist ./landing-dist
COPY --from=build /app/mobile-dist ./mobile-dist
COPY --from=build /app/build/mycellios-coordinator-output-receipt.json \
    ./build/mycellios-coordinator-output-receipt.json
COPY --from=build /app/REVISION ./REVISION
COPY --from=build /app/mycellios-native-build-provenance.json \
    ./mycellios-native-build-provenance.json
COPY python ./python
COPY config ./config

EXPOSE 4174
CMD ["npm", "run", "start:coordinator"]
