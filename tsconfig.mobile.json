{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types", "vite/client"]
  },
  "include": ["src/mobile/**/*.ts", "src/mobile/**/*.tsx", "landing/src/Panel.tsx", "landing/src/Contribute.tsx", "vite.mobile.config.ts"]
}
